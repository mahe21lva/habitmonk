---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookEntry from '../../components/BookEntry.astro';
import { faculties } from '../../data/faculties';

const entries = await getCollection('readings');

const rows = entries.map((e) => ({
  id: e.id,
  title: e.data.title,
  author: e.data.author,
  faculty: e.data.faculty,
  subject: e.data.subject,
  subthread: e.data.subthread,
  note: e.data.note,
  finished: e.data.finished,
  hasEssay: !!e.body && e.body.trim().length > 0,
}));
type Row = (typeof rows)[number];

// Within a faculty: dated books newest-first, then undated alphabetically.
function ordered(list: Row[]) {
  const dated = list.filter((r) => r.finished)
    .sort((a, b) => b.finished!.date.getTime() - a.finished!.date.getTime());
  const undated = list.filter((r) => !r.finished)
    .sort((a, b) => a.title.localeCompare(b.title));
  return [...dated, ...undated];
}

function partition(list: Row[]) {
  const loose = ordered(list.filter((r) => !r.subthread));
  const threads = new Map<string, Row[]>();
  for (const r of list) {
    if (!r.subthread) continue;
    if (!threads.has(r.subthread)) threads.set(r.subthread, []);
    threads.get(r.subthread)!.push(r);
  }
  for (const [k, v] of threads) threads.set(k, ordered(v));
  return { loose, threads };
}

const metaFor = (r: Row) => (r.finished ? `Finished ${r.finished.label}` : undefined);
const subjects = [...new Set(rows.filter((r) => !r.faculty && r.subject).map((r) => r.subject!))].sort();
const facultyTotal = rows.filter((r) => r.faculty).length;
const subjectTotal = rows.filter((r) => !r.faculty && r.subject).length;
const hrefFor = (r: Row) => (r.hasEssay ? `/readings/book/${r.id}` : undefined);
---

<BaseLayout title="Readings — The Habit Monk">
  <section class="wrap page">
    <header class="page-head">
      <span class="meta">Readings</span>
      <h1 class="page-title">Books, by the faculty they train.</h1>
      <hr class="rule" />
      <p class="page-lede">
        Grouped not by shelf but by what each book trains in the mind. Notes are
        my own take on what stuck — not summaries. A title becomes a link once
        it has earned a longer piece.
      </p>
    </header>

    {faculties.map((f) => {
      const { loose, threads } = partition(rows.filter((r) => r.faculty === f.slug));
      const count = loose.length + [...threads.values()].flat().length;
      if (count === 0) return null;
      return (
        <section class="faculty">
          <div class="faculty-head">
            <a class="faculty-name" href={`/readings/${f.slug}`}>{f.name}</a>
            <span class="faculty-tagline">{f.tagline}</span>
            <span class="faculty-count">{count}</span>
          </div>

          <div class="list">
            {loose.map((r) => (
              <BookEntry title={r.title} author={r.author} meta={metaFor(r)} note={r.note} href={hrefFor(r)} />
            ))}

            {[...threads.entries()].map(([name, list]) => (
              <div class="subthread">
                <span class="subthread-label">{name}</span>
                {list.map((r) => (
                  <BookEntry title={r.title} author={r.author} meta={metaFor(r)} note={r.note} href={hrefFor(r)} />
                ))}
              </div>
            ))}
          </div>
        </section>
      );
    })}

    {subjects.length > 0 && (
      <section class="by-subject">
        <header class="subject-intro">
          <span class="meta">By subject · {subjectTotal} books</span>
          <h2 class="subject-title">The wider shelf.</h2>
          <p class="page-lede">
            Everything else I've read, sorted by what it's about rather than what
            it trains. History and politics for the citizen-self, AI and tech for
            the work-self. Most are just a title and a year.
          </p>
        </header>

        {subjects.map((name, i) => {
          const list = ordered(rows.filter((r) => !r.faculty && r.subject === name));
          return (
            <details class="subject" open={i === 0}>
              <summary class="subject-head">
                <span class="subject-name">{name}</span>
                <span class="faculty-count">{list.length}</span>
              </summary>
              <ul class="compact">
                {list.map((r) => (
                  <li>
                    {r.hasEssay ? <a class="c-title" href={hrefFor(r)}>{r.title}</a> : <span class="c-title">{r.title}</span>}
                    <span class="c-author">{r.author}</span>
                    {r.finished && <span class="c-year">{r.finished.label}</span>}
                    {r.note && <p class="c-note">{r.note}</p>}
                  </li>
                ))}
              </ul>
            </details>
          );
        })}
      </section>
    )}
  </section>
</BaseLayout>

<style>
  .page { padding: 4rem 0 0; }
  .page-head { max-width: 60ch; margin-bottom: 2.5rem; }
  .page-title { font-size: clamp(32px, 4.5vw, 44px); margin-top: 0.6rem; }
  .page-lede { font-family: var(--font-body); font-size: 19px; color: var(--muted); margin: 0; max-width: 62ch; }

  .faculty { margin-top: 3.25rem; }

  .faculty-head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--gold);
  }
  .faculty-name {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--ink);
  }
  .faculty-name:hover { color: var(--gold-deep); }
  .faculty-tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 16px;
    color: var(--faint);
  }
  .faculty-count {
    margin-left: auto;
    font-family: var(--font-meta);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .subthread {
    margin-top: 0.4rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--hairline);
  }
  .subthread-label {
    display: block;
    font-family: var(--font-meta);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0.9rem 0 0.2rem;
  }

  .by-subject { margin-top: 5rem; padding-top: 2.5rem; border-top: 1px solid var(--hairline); }
  .subject-intro { max-width: 62ch; margin-bottom: 1.5rem; }
  .subject-title { font-size: clamp(26px, 3.5vw, 34px); margin: 0.5rem 0 0.8rem; }
  .subject { margin-top: 1.4rem; }
  .subject-head {
    display: flex; align-items: baseline; gap: 0.85rem;
    padding-bottom: 0.35rem; border-bottom: 1px solid var(--gold);
    cursor: pointer; list-style: none;
  }
  .subject-head::-webkit-details-marker { display: none; }
  .subject-head::before {
    content: '+'; font-family: var(--font-meta); color: var(--gold); width: 0.8rem;
  }
  .subject[open] > .subject-head::before { content: '−'; }
  .subject-name { font-family: var(--font-display); font-size: 21px; color: var(--ink); }
  .compact { list-style: none; margin: 0; padding: 0; }
  .compact li {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.65rem;
    padding: 0.55rem 0 0.55rem 1.65rem; border-bottom: 1px solid var(--hairline);
  }
  .c-title { font-family: var(--font-display); font-size: 17px; color: var(--ink); }
  a.c-title:hover { color: var(--gold-deep); }
  .c-author { font-family: var(--font-body); font-style: italic; font-size: 16px; color: var(--muted); }
  .c-year { margin-left: auto; font-family: var(--font-meta); font-size: 12px; letter-spacing: 0.04em; color: var(--faint); }
  .c-note { flex-basis: 100%; margin: 0.15rem 0 0; font-family: var(--font-body); font-size: 16px; color: var(--muted); }

  @media (max-width: 600px) {
    .faculty-head { flex-wrap: wrap; gap: 0.35rem 0.7rem; }
    .faculty-count { margin-left: 0; flex-basis: 100%; }
  }
</style>
