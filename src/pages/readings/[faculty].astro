---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookEntry from '../../components/BookEntry.astro';
import { faculties, facultyBySlug } from '../../data/faculties';

export const getStaticPaths = (() =>
  faculties.map((f) => ({ params: { faculty: f.slug } }))) satisfies GetStaticPaths;

const { faculty: slug } = Astro.params;
const faculty = facultyBySlug[slug as keyof typeof facultyBySlug];

const entries = (await getCollection('readings')).filter((e) => e.data.faculty === slug);

const rows = entries.map((e) => ({
  id: e.id,
  title: e.data.title,
  author: e.data.author,
  subthread: e.data.subthread,
  note: e.data.note,
  finished: e.data.finished,
  hasEssay: !!e.body && e.body.trim().length > 0,
}));
type Row = (typeof rows)[number];

function ordered(list: Row[]) {
  const dated = list.filter((r) => r.finished)
    .sort((a, b) => b.finished!.date.getTime() - a.finished!.date.getTime());
  const undated = list.filter((r) => !r.finished)
    .sort((a, b) => a.title.localeCompare(b.title));
  return [...dated, ...undated];
}

const loose = ordered(rows.filter((r) => !r.subthread));
const threads = new Map<string, Row[]>();
for (const r of rows) {
  if (!r.subthread) continue;
  if (!threads.has(r.subthread)) threads.set(r.subthread, []);
  threads.get(r.subthread)!.push(r);
}
for (const [k, v] of threads) threads.set(k, ordered(v));

const metaFor = (r: Row) => (r.finished ? `Finished ${r.finished.label}` : undefined);
const hrefFor = (r: Row) => (r.hasEssay ? `/readings/book/${r.id}` : undefined);
---

<BaseLayout title={`${faculty.name} — Readings`}>
  <section class="wrap page">
    <a href="/readings" class="back">&larr; Readings</a>
    <header class="page-head">
      <span class="meta">Readings · Faculty</span>
      <h1 class="page-title">{faculty.name}</h1>
      <hr class="rule" />
      <p class="page-lede">{faculty.tagline}.</p>
    </header>

    {faculty.intro && <div class="intro prose-measure" set:html={faculty.intro} />}

    <div class="list">
      {loose.map((r) => (
        <BookEntry title={r.title} author={r.author} meta={metaFor(r)} note={r.note} href={hrefFor(r)} />
      ))}

      {[...threads.entries()].map(([name, list]) => (
        <div class="subthread">
          <span class="subthread-label">{name}</span>
          {list.map((r) => (
            <BookEntry title={r.title} author={r.author} meta={metaFor(r)} note={r.note} href={hrefFor(r)} />
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 3rem 0 0; }
  .back {
    font-family: var(--font-meta);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .back:hover { color: var(--navy); }
  .page-head { max-width: 60ch; margin: 2rem 0 2rem; }
  .page-title { font-size: clamp(32px, 4.5vw, 46px); margin-top: 0.6rem; }
  .page-lede { font-family: var(--font-body); font-size: 19px; color: var(--muted); margin: 0; }

  .intro { font-size: 19px; line-height: 1.7; color: var(--ink); margin: 0 0 1.5rem; }

  .subthread {
    margin-top: 0.4rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--hairline);
  }
  .subthread-label {
    display: block;
    font-family: var(--font-meta);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0.9rem 0 0.2rem;
  }
</style>
