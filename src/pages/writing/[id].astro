---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const essays = await getCollection('articles');
  return essays.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection('articles');
const parent = entry.data.grewFrom ? all.find((e) => e.id === entry.data.grewFrom) : undefined;
if (entry.data.grewFrom && !parent) throw new Error(`grewFrom "${entry.data.grewFrom}" in ${entry.id} doesn't match any article`);
const children = all
  .filter((e) => e.data.grewFrom === entry.id)
  .sort((a, b) => a.data.date.date.getTime() - b.data.date.date.getTime());
const stageOf = (e: typeof entry) => (e.data.stage === 'forming' ? 'Level 0 · Forming' : null);

const fmt = entry.data.date.long;
const forming = entry.data.stage === 'forming';

const topicLabel =
  entry.data.topic === 'work' ? 'Work-self'
  : entry.data.topic === 'citizen' ? 'Citizen-self'
  : null;
---

<BaseLayout title={`${entry.data.title} — Writing`} description={entry.data.excerpt}>
  <article class="wrap post">
    <a href="/writing" class="back">&larr; Writing</a>
    <header class="post-head">
      <span class="meta">
        {fmt}{topicLabel && <><span class="sep">·</span>{topicLabel}</>}
        {forming && <><span class="sep">·</span><span class="stage">Level 0 · Forming</span></>}
      </span>
      <h1 class="post-title">{entry.data.title}</h1>
      {forming && (
        <p class="forming-note">
          A forming piece, written while the idea was still taking shape. Short
          lines, unrevised, kept as it was.{children.length === 0 && ' A refined version comes later.'}
        </p>
      )}
    </header>
    <div class:list={['content', 'prose-measure', { forming }]}>
      <Content />
    </div>

    {(parent || children.length > 0) && (
      <aside class="lineage prose-measure">
        <span class="lineage-label">How this idea grew</span>
        {parent && (
          <p>
            <span class="lineage-rel">Grew out of</span>
            <a href={`/writing/${parent.id}`}>{parent.data.title}</a>
            <span class="lineage-meta">{parent.data.date.label}{stageOf(parent) && ` · ${stageOf(parent)}`}</span>
          </p>
        )}
        {children.map((c) => (
          <p>
            <span class="lineage-rel">Led to</span>
            <a href={`/writing/${c.id}`}>{c.data.title}</a>
            <span class="lineage-meta">{c.data.date.label}{stageOf(c) && ` · ${stageOf(c)}`}</span>
          </p>
        ))}
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .stage { color: var(--cool); }
  .lineage {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }
  .lineage-label {
    display: block;
    font-family: var(--font-meta);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.6rem;
  }
  .lineage p { margin: 0.35rem 0; font-family: var(--font-body); font-size: 18px; }
  .lineage-rel { color: var(--muted); margin-right: 0.5rem; }
  .lineage a { color: var(--ink); border-bottom: 1px solid var(--hairline); }
  .lineage a:hover { color: var(--gold-deep); }
  .lineage-meta { margin-left: 0.6rem; font-family: var(--font-meta); font-size: 12px; color: var(--faint); }
  .forming-note {
    margin: 1rem 0 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 17px;
    color: var(--faint);
  }
  .content.forming :global(p) { margin: 0 0 1.6rem; line-height: 1.6; }

  .post { padding: 3rem 0 0; }
  .back {
    font-family: var(--font-meta);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .back:hover { color: var(--navy); }
  .post-head { margin: 2rem 0 2.5rem; max-width: 62ch; }
  .sep { margin: 0 0.5rem; color: var(--hairline); }
  .post-title { font-size: clamp(32px, 5vw, 50px); margin-top: 0.7rem; }

  .content { font-size: 20px; line-height: 1.75; color: var(--ink); }
  .content :global(p) { margin: 0 0 1.5rem; }
  .content :global(h2) { font-size: 28px; margin: 2.6rem 0 1rem; }
  .content :global(h3) { font-size: 22px; margin: 2rem 0 0.8rem; }
  .content :global(blockquote) {
    border-left: 2px solid var(--gold);
    margin: 1.6rem 0;
    padding: 0.2rem 0 0.2rem 1.4rem;
    font-style: italic;
    color: var(--muted);
  }
  .content :global(a) { border-bottom: 1px solid var(--hairline); }
  .content :global(hr) { border: 0; border-top: 1px solid var(--hairline); margin: 2.5rem 0; }
  .content :global(em) { color: var(--navy); }
</style>
