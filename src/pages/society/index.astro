---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocietyEntry from '../../components/SocietyEntry.astro';

const positions = (await getCollection('society'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Society — The Habit Monk">
  <section class="wrap page">
    <header class="page-head">
      <span class="meta">Society</span>
      <h1 class="page-title">Living positions on the world.</h1>
      <hr class="rule" />
      <p class="page-lede">
        Not a blog. These are stances I currently hold — each dated, each
        carrying a status, each open to revision. Nothing here is deleted; when
        a view changes, the change is recorded rather than erased.
      </p>
    </header>

    <div class="list">
      {positions.map((e) => (
        <SocietyEntry
          href={`/society/${e.id}`}
          title={e.data.title}
          date={e.data.date}
          status={e.data.status}
          summary={e.data.summary}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 4rem 0 0; }
  .page-head { max-width: 60ch; margin-bottom: 2.5rem; }
  .page-title { font-size: clamp(32px, 4.5vw, 44px); margin-top: 0.6rem; }
  .page-lede { font-family: var(--font-body); font-size: 19px; color: var(--muted); margin: 0; }
</style>
