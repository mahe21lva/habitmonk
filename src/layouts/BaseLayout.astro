---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Habit Monk',
  description = 'A record of one mind changing — on learning, on society, on itself.',
} = Astro.props;

const nav = [
  { label: 'About', href: '/about' },
  { label: 'Readings', href: '/readings' },
  { label: 'Reading List', href: '/reading-list' },
  { label: 'Writing', href: '/writing' },
  { label: 'Society', href: '/society' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap head-inner">
        <a href="/" class="brand" aria-label="The Habit Monk — home">
          <img class="brand-mark" src="/logo-mark.png" alt="" width="30" height="40" />
          <span class="brand-word">habitmonk</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', { active: path === item.href }]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <div class="foot-mark">
          <span class="foot-truth">Truth</span>
          <span class="foot-rule"></span>
          <span class="foot-cog">Cognition</span>
        </div>
        <p class="foot-line">
          The Habit Monk — thought, carried toward the truth.
        </p>
        <p class="foot-copy">&copy; {new Date().getFullYear()} · Mahendranath</p>
      </div>
    </footer>

    <style>
      .site-head {
        border-bottom: 1px solid var(--hairline);
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      .brand-mark {
        height: 40px;
        width: auto;
        display: block;
      }
      .brand-word {
        font-family: var(--font-meta);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--navy);
      }
      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
      }
      .nav-link {
        font-family: var(--font-meta);
        font-size: 13px;
        letter-spacing: 0.01em;
        color: var(--faint);
        padding-bottom: 2px;
        border-bottom: 1.5px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .nav-link:hover { color: var(--navy); }
      .nav-link.active {
        color: var(--navy);
        border-color: var(--gold);
      }

      .site-foot {
        margin-top: 6rem;
        border-top: 1px solid var(--hairline);
        padding: 3rem 0 4rem;
      }
      .foot-inner { text-align: center; }
      .foot-mark { display: inline-block; margin-bottom: 1.25rem; }
      .foot-truth, .foot-cog {
        display: block;
        font-family: var(--font-display);
        font-size: 12px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
      }
      .foot-truth { color: var(--gold-deep); }
      .foot-cog { color: var(--navy); }
      .foot-rule {
        display: block;
        width: 64px;
        height: 1.5px;
        background: var(--gold);
        margin: 3px auto;
      }
      .foot-line {
        font-family: var(--font-body);
        font-style: italic;
        font-size: 17px;
        color: var(--muted);
        margin: 0 0 0.5rem;
      }
      .foot-copy {
        font-family: var(--font-meta);
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--faint);
        margin: 0;
      }

      @media (max-width: 600px) {
        .head-inner { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
        .nav { gap: 1rem; }
      }
    </style>
  </body>
</html>
