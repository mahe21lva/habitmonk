---
import type { Finished } from '../data/finished';

interface Props {
  href: string;
  title: string;
  date: Finished;
  status: 'forming' | 'held' | 'revised';
  summary?: string;
}

const { href, title, date, status, summary } = Astro.props;

const fmt = date.long;
---

<a href={href} class="entry">
  <span class="date">{fmt}</span>
  <span class="body">
    <span class:list={['tag', status]}>{status}</span>
    <span class="title">{title}</span>
    {summary && <span class="summary">{summary}</span>}
  </span>
</a>

<style>
  .entry {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
    color: inherit;
  }
  .entry:hover .title { color: var(--gold-deep); }
  .date {
    font-family: var(--font-meta);
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: var(--faint);
    padding-top: 3px;
  }
  .tag {
    font-family: var(--font-meta);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 1px 7px;
    margin-right: 0.7rem;
    vertical-align: 2px;
  }
  .tag.held    { color: var(--gold-deep); border-color: #D8C68E; }
  .tag.forming { color: var(--navy);      border-color: #B9C4D2; }
  .tag.revised { color: #7A5A8A;          border-color: #CDBBD6; }
  .title {
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .summary {
    display: block;
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--muted);
    margin-top: 0.25rem;
    max-width: 58ch;
  }
  @media (max-width: 560px) {
    .entry { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
