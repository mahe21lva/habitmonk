---
interface Props {
  title: string;
  author: string;
  meta?: string;      // e.g. "Finished August 2026"
  note?: string;
  href?: string;      // set only when the book has a full essay (its body is non-empty)
}

const { title, author, meta, note, href } = Astro.props;
---

<div class="book">
  <div class="head">
    {href
      ? <a class="title title-link" href={href}>{title}</a>
      : <span class="title">{title}</span>}
    <span class="author">{author}</span>
  </div>
  {meta && <span class="when">{meta}</span>}
  {note && <p class="note">{note}</p>}
</div>

<style>
  .book {
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }
  .title {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--ink);
  }
  .title-link {
    border-bottom: 1px solid var(--hairline);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .title-link:hover {
    color: var(--gold-deep);
    border-color: var(--gold);
  }
  .author {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 17px;
    color: var(--faint);
  }
  .when {
    font-family: var(--font-meta);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    color: var(--faint);
  }
  .note {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--muted);
    margin: 0.4rem 0 0;
    max-width: 60ch;
  }
</style>
